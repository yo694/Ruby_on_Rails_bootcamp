<% cache ["book-fragment", book[:title]] do %>

  <div>
    <h3>
      <%= book[:title] %>
    </h3>

    <p>
      Author:
      <%= book[:author] %>
    </p>

    <p>
      Category:
      <%= book[:category] %>
    </p>

    <p>
      Available:
      <%= book[:available] %>
    </p>
  </div>

  <hr>

<% end %>