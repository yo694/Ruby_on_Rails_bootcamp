<% @books.each do |book| %>

  <% cache ["book-fragment", book[:id]] do %>

    <div>

      <h3>
        <%= book[:title] %>
      </h3>

      <p>
        Author:
        <%= book[:author] %>
      </p>

      <p>
        Category:
        <%= book[:category] %>
      </p>

      <p>
        Available:
        <%= book[:available] %>
      </p>

    </div>

    <hr>

  <% end %>

<% end %>