<% content_for :page_title do %>
  <title>Books</title>
<% end %>

<h2>Library Books</h2>

<%= turbo_frame_tag "book_form" do %>
  <p>
    <%= link_to "Add New Book", new_book_path %>
  </p>
<% end %>

<%= turbo_frame_tag "books" do %>

  <% @books.each do |book| %>
    <%= render "book", book: book %>
  <% end %>

<% end %>