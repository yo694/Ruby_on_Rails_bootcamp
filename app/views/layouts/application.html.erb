<!DOCTYPE html>
<html>
<head>
  <title>Library App</title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= javascript_importmap_tags %>

  <%= yield :page_title %>
</head>

<body>

  <%= render "shared/navbar" %>

  <hr>

  <div id="flash">
    <% flash.each do |type, message| %>
      <div class="flash <%= type %>"><%= message %></div>
    <% end %>
  </div>

  <hr>

  <%= yield %>

  <hr>

  <%= render "shared/footer" %>

</body>
</html>
